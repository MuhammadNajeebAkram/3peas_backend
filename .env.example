APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
OPEN_AI_API_KEY=
OPENAI_TIMEOUT=45
OPENAI_MAX_OUTPUT_TOKENS=1800
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4100,http://127.0.0.1:4100,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,https://thestudentstimes.com,https://www.thestudentstimes.com,https://admin.thestudentstimes.com,https://api.thestudentstimes.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_RECEIPT_EXTRACTION_MODEL=gpt-6-luna
OPENAI_RECEIPT_EXTRACTION_TIMEOUT=25
OPENAI_RECEIPT_EXTRACTION_MAX_OUTPUT_TOKENS=400
OPENAI_TIMEOUT=45
OPENAI_MAX_OUTPUT_TOKENS=1800

# Standardized AI API Credentials (dynamically resolved by APP_ENV + provider key + feature)
# Development (APP_ENV in local|development|testing): AI_{PROVIDER}_DEV_KEY
AI_OPENAI_DEV_KEY=
AI_GEMINI_DEV_KEY=
AI_QWEN_DEV_KEY=
# Staging (APP_ENV = staging): AI_{PROVIDER}_{FEATURE}_STAGING_KEY
AI_OPENAI_RECEIPT_EXTRACTION_STAGING_KEY=
AI_GEMINI_RECEIPT_EXTRACTION_STAGING_KEY=
AI_QWEN_RECEIPT_EXTRACTION_STAGING_KEY=
# Production (APP_ENV = production): AI_{PROVIDER}_{FEATURE}_PROD_KEY
AI_OPENAI_RECEIPT_EXTRACTION_PROD_KEY=
AI_GEMINI_RECEIPT_EXTRACTION_PROD_KEY=
AI_QWEN_RECEIPT_EXTRACTION_PROD_KEY=
# Optional defaults & provider base URLs
RECEIPT_EXTRACTION_AI_PROVIDER=openai
RECEIPT_EXTRACTION_AI_ENABLED=true
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

TESSERACT_BINARY=tesseract
TESSERACT_LANG=eng
PDFTOTEXT_BINARY=pdftotext
PDFTOPPM_BINARY=pdftoppm
RECEIPT_OCR_TIMEOUT=20
GEMINI_API_KEY=
GEMINI_TIMEOUT=45
GEMINI_MAX_OUTPUT_TOKENS=1800
AI_QUESTION_MAX_OUTPUT_TOKENS=12000
AI_QUESTION_TIMEOUT=90
AI_QUESTION_DIAGRAM_DISK=s3
